<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0 -->
<interface>
  <!-- interface-name store_page_main.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="main_box">
    <property name="css-classes">white_box</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox" id="searchbar">
        <property name="css-classes">search_bar_box
</property>
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="spacing">20</property>
        <child>
          <object class="GtkSearchEntry" id="search">
            <property name="css-classes">search_bar</property>
            <property name="hexpand">True</property>
            <property name="hexpand-set">True</property>
          </object>
        </child>
        <child>
          <object class="GtkAspectFrame">
            <child>
              <object class="GtkButton" id="tdl_show_button">
                <property name="css-classes">side-button</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <child>
          <object class="GtkListBox">
            <property name="css-classes">mp_listbox</property>
            <property name="vexpand">True</property>
            <property name="vexpand-set">True</property>
            <child>
              <object class="GtkButton">
                <property name="css-classes">
</property>
              </object>
            </child>
            <child>
              <object class="GtkButton"/>
            </child>
            <child>
              <object class="GtkButton"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkBox" id="side_box">
    <property name="css-classes">side_box</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox" id="side_title_box">
        <property name="margin-bottom">20</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">20</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkAspectFrame">
            <child>
              <object class="GtkButton" id="side_hide_button">
                <property name="css-classes">side-button</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="hexpand">True</property>
            <property name="hexpand-set">True</property>
            <property name="label">代办事项</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <child>
          <object class="GtkListBox">
            <property name="margin-end">6</property>
            <property name="margin-start">6</property>
            <property name="vexpand">True</property>
            <property name="vexpand-set">True</property>
            <child>
              <object class="GtkButton"/>
            </child>
            <child>
              <object class="GtkButton"/>
            </child>
            <child>
              <object class="GtkButton"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
